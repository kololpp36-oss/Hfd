---------------------------------------------------------
local rainbowRotation = 0

RunService.RenderStepped:Connect(function(dt)
    if isMenuOpen then
        rainbowRotation = (rainbowRotation + 60 * dt) % 360
        rainbowGradient.Rotation = rainbowRotation
    end

    if isLocked then
        if not targetHead or not targetHead.Parent or targetHead.Parent:FindFirstChild("Humanoid").Health <= 0 or not isVisible(targetHead) then
            targetHead = getClosestPlayerHead()
        end

        if targetHead then
            local camPos = camera.CFrame.Position
            camera.CFrame = CFrame.new(camPos, targetHead.Position)
        end
    end

    if isWallhackOn then
        updateESP()
    end
end)
